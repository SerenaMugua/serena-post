{
  "name": "serena-post",
  "version": "1.1.1",
  "description": "Obsidian plugin: push one note to WeChat Official Account drafts and X Article drafts.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node tests/run.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wechat",
    "x",
    "twitter",
    "draft"
  ],
  "author": "Serena 木瓜",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.14.5",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "html2canvas": "^1.4.1",
    "https-proxy-agent": "^7.0.6",
    "marked": "^9.1.6",
    "marked18": "npm:marked@^18.0.14",
    "postcss": "^8.5.19",
    "socks-proxy-agent": "^8.0.5"
  }
}
